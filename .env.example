# ============================================================================
# Environment Variables - Tech Challenge Fase 4
# ============================================================================
# Copie este arquivo para .env e preencha com suas chaves

# LLM APIs (escolha uma ou mais)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=your_google_api_key_here

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss  # Options: faiss, chroma
VECTOR_STORE_PATH=./data/vector_store

# Embeddings Configuration
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# RAG Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
TEMPERATURE=0.3

# Data Paths
DATA_PATH=./dados
REVIEWS_CSV=./dados/reviews_for_rag.csv

# Logging
LOG_LEVEL=INFO
